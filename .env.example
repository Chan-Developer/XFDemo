# Fine-tuned VLM served by SGLang/OpenAI-compatible API
VLLM_API_BASE=http://127.0.0.1:9300/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=XF-VLM

# Qwen judge model
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-plus

# Generation
TEMPERATURE=0.1
TOP_P=0.8
MAX_TOKENS=768
ENABLE_THINKING=false

# YOLO component detector
YOLO_ENABLED=1
YOLO_PYTHON=/path/to/yolo/python
YOLO_INFER_SCRIPT=/path/to/XFDemo/scripts/yolo_infer.py
YOLO_INTERNAL_WEIGHTS=/path/to/fire_hydrant_v3.pt
YOLO_CLASSES_FILE=/path/to/classes.json
YOLO_CONF=0.20
YOLO_IMGSZ=640
YOLO_DEVICE=0

# Dedicated PipesCounting service on L40
PIPE_COUNTING_BASE_URL=http://127.0.0.1:9400
PIPE_COUNTING_TIMEOUT=120
PIPE_COUNTING_HISTORY_ROOT=/data/clj/Project/XFDemo/logs/pipe_counting_history
PIPES_MODEL_PATH=/data/clj/output/yolo/pipes_counting/final_weights.pt
PIPES_DEVICE=2
PIPES_HOST=127.0.0.1
PIPES_PORT=9400
PIPES_CONFIDENCE=0.25
PIPES_IOU=0.45
PIPES_IMAGE_SIZE=640
PIPES_MAX_DETECTIONS=2000

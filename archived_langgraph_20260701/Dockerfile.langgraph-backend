FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-langgraph-backend.txt ./
RUN pip install -r requirements-langgraph-backend.txt

COPY backend ./backend
COPY langgraph_backend.py prompt.py ./

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--timeout", "600", "langgraph_backend:app"]
